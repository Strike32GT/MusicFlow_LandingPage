---
import '../styles/global.css';

const steps = [
  ['01', 'Crea tu perfil', 'Regístrate como artista y solicita la verificación de tu identidad.'],
  ['02', 'Sube tu música', 'Añade archivos WAV o FLAC, portada, créditos y letra.'],
  ['03', 'Publica y crece', 'Programa tu lanzamiento y sigue tus estadísticas.'],
];

const benefits = [
  ['Subida directa', 'Sube tus canciones en WAV o FLAC sin intermediarios ni distribuidoras.'],
  ['Estadísticas en tiempo real', 'Conoce oyentes, países, retención y preferencias de ecualización.'],
  ['Presets oficiales', 'Publica la EQ recomendada para que tu música suene como la imaginaste.'],
  ['Impulso con FlowIA', 'Tus temas pueden aparecer en playlists generadas por IA.'],
  ['Conecta con fans', 'Perfil verificado, lanzamientos programados y mensajes a seguidores.'],
];

const artistFaqs = [
  ['¿Cómo publico un lanzamiento?', 'Completa el perfil, añade la información del lanzamiento y envíalo para revisión antes de publicarlo.'],
  ['¿Qué formatos aceptan?', 'Puedes preparar tus canciones en WAV o FLAC.'],
  ['¿Conservo mis derechos?', 'Sí. Conservas tus derechos; MusicFlow solo procesa la distribución autorizada.'],
  ['¿Qué datos muestra el panel?', 'El panel reúne señales de audiencia como oyentes, reproducciones y canciones guardadas.'],
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="MusicFlow para artistas: publica audio sin pérdida, comparte presets oficiales y sigue tus estadísticas." />
    <title>Para artistas | MusicFlow</title>
  </head>
  <body class="min-h-screen bg-white text-ink">
    <header class="sticky top-0 z-50 border-b border-line/70 bg-white/95 backdrop-blur-xl">
      <nav class="mx-auto flex h-[76px] max-w-7xl items-center justify-between px-5 sm:px-8 lg:px-10" aria-label="Navegación principal">
        <a href="/" class="focusable flex items-center gap-2.5 rounded-full"><img src="/assets/music-flow.png" alt="" width="44" height="44" class="h-10 w-10 rounded-full object-cover" /><span class="font-display text-xl font-extrabold tracking-[-0.04em]">Music<span class="text-pulse">Flow</span></span></a>
        <div class="hidden items-center gap-7 text-[13px] font-semibold text-slate-600 lg:flex"><a href="/#caracteristicas" class="hover:text-pulse">Características</a><a href="/#plataformas" class="hover:text-pulse">Plataformas</a><a href="/#comparativa" class="hover:text-pulse">Comparativa</a><a href="/#comunidad" class="hover:text-pulse">Comunidad</a><a href="/documentacion" class="hover:text-pulse">Documentación</a><a href="/artistas" class="text-pulse">Artistas</a></div>
        <a href="https://musicflowapp.net/artist-login" class="focusable rounded-full bg-pulse px-5 py-3 text-sm font-extrabold text-white shadow-glow">Crear perfil</a>
      </nav>
    </header>

    <main>
      <section id="crear-perfil" class="artist-hero px-5 pb-24 pt-14 sm:px-8 lg:px-10 lg:pb-28 lg:pt-20">
        <div class="mx-auto grid max-w-7xl items-center gap-16 lg:grid-cols-[0.93fr_1.07fr]">
          <div><div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-white/80 px-3 py-2 text-sm font-extrabold text-pulse"><img src="/assets/music-flow.png" alt="" class="h-6 w-6 rounded-full object-cover" />MusicFlow for Artists</div><h1 class="mt-7 font-display text-5xl font-extrabold leading-[1.04] tracking-[-0.05em] sm:text-6xl">Crea y sube tu música <span class="text-pulse">aquí en MusicFlow</span></h1><p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">Publica tus lanzamientos, comparte presets de EQ oficiales y conoce cómo responde tu audiencia a cada canción.</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><a href="https://musicflowapp.net/artist-login" class="focusable inline-flex min-h-14 items-center justify-center gap-2 rounded-full bg-pulse px-7 text-sm font-extrabold text-white shadow-glow">Crear perfil de artista <span aria-hidden="true">→</span></a><a href="#como-funciona" class="focusable inline-flex min-h-14 items-center justify-center rounded-full border border-line bg-white px-7 text-sm font-extrabold">Leer guía</a></div><dl class="mt-10 grid max-w-md grid-cols-3 gap-5"><div><dd class="text-2xl font-extrabold">WAV/FLAC</dd><dt class="mt-1 text-xs text-slate-500">Formatos de audio</dt></div><div><dd class="text-2xl font-extrabold">EQ</dd><dt class="mt-1 text-xs text-slate-500">Presets oficiales</dt></div><div><dd class="text-2xl font-extrabold">Datos</dd><dt class="mt-1 text-xs text-slate-500">Panel de audiencia</dt></div></dl></div>
          <div id="subir" class="artist-upload-card rounded-[2rem] border border-line bg-white p-5 shadow-device sm:p-7"><div class="flex items-center justify-between"><div><p class="text-xs font-extrabold uppercase tracking-wider text-pulse">Nuevo lanzamiento</p><h2 class="mt-1 text-xl font-extrabold">Borrador</h2></div><span class="rounded-full bg-amber-50 px-3 py-2 text-xs font-bold text-amber-700">Pendiente</span></div><div class="mt-6 grid min-h-48 place-items-center rounded-2xl border-2 border-dashed border-blue-200 bg-blue-50/60 p-6 text-center"><span class="grid h-12 w-12 place-items-center rounded-full bg-pulse text-white"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 16V4m0 0-4 4m4-4 4 4M5 20h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><div class="mt-4"><p class="font-extrabold">Arrastra tus canciones aquí</p><p class="mt-1 text-sm text-slate-500">o haz clic para seleccionarlas · Solo WAV y FLAC</p></div></div><div class="mt-5 space-y-3"><div class="flex items-center justify-between rounded-xl bg-soft px-4 py-3 text-sm"><span class="font-semibold">Midnight_Waves_master.flac</span><span class="text-emerald-600">✓ Listo</span></div><div class="flex items-center justify-between rounded-xl bg-soft px-4 py-3 text-sm"><span class="font-semibold">Blue_Horizon_v2.wav</span><span class="text-emerald-600">✓ Listo</span></div></div><button type="button" class="mt-6 w-full rounded-full bg-pulse px-6 py-3 text-sm font-extrabold text-white">Publicar lanzamiento</button></div>
        </div>
      </section>

      <section id="como-funciona" class="px-5 py-24 sm:px-8 lg:px-10"><div class="mx-auto max-w-7xl"><div class="text-center"><p class="section-label">Cómo funciona</p><h2 class="mt-4 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">De tu estudio al mundo en 3 pasos</h2></div><div class="mt-14 grid gap-6 md:grid-cols-3">{steps.map(([number, title, body]) => <article class="rounded-3xl border border-line bg-white p-7 shadow-card"><p class="font-display text-4xl font-extrabold text-pulse/25">{number}</p><h3 class="mt-6 text-xl font-extrabold">{title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{body}</p></article>)}</div></div></section>

      <section class="bg-soft px-5 py-24 sm:px-8 lg:px-10"><div class="mx-auto max-w-7xl"><div class="mx-auto max-w-3xl text-center"><p class="section-label">Beneficios</p><h2 class="mt-4 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Herramientas pensadas para artistas</h2></div><div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{benefits.map(([title, body]) => <article class="rounded-3xl border border-line bg-white p-7"><span class="grid h-11 w-11 place-items-center rounded-2xl bg-blue-50 text-pulse" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none"><path d="M5 4v16M12 4v16M19 4v16M3 9h4M10 15h4M17 7h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></span><h3 class="mt-6 text-xl font-extrabold">{title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{body}</p></article>)}</div></div></section>

      <section class="px-5 py-24 sm:px-8 lg:px-10"><div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[0.85fr_1.15fr]"><div><p class="section-label">Estadísticas</p><h2 class="mt-4 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Tu música, tus números</h2><p class="mt-5 text-lg leading-8 text-slate-600">Un panel claro para conocer cómo crece tu audiencia y qué partes de tus canciones prefieren tus fans.</p><a href="https://musicflowapp.net/artist-login" class="mt-8 inline-flex rounded-full bg-pulse px-6 py-3 text-sm font-extrabold text-white shadow-glow">Crear perfil</a></div><div class="rounded-[2rem] border border-line bg-white p-7 shadow-card"><div class="grid grid-cols-3 gap-4"><div class="rounded-2xl bg-soft p-4"><p class="text-xs font-bold text-slate-500">Oyentes</p><p class="mt-2 text-2xl font-extrabold">48.2K</p><p class="mt-1 text-xs font-bold text-emerald-600">+12%</p></div><div class="rounded-2xl bg-soft p-4"><p class="text-xs font-bold text-slate-500">Reproducciones</p><p class="mt-2 text-2xl font-extrabold">312K</p><p class="mt-1 text-xs font-bold text-emerald-600">+28%</p></div><div class="rounded-2xl bg-soft p-4"><p class="text-xs font-bold text-slate-500">Guardados</p><p class="mt-2 text-2xl font-extrabold">9.4K</p><p class="mt-1 text-xs font-bold text-emerald-600">+9%</p></div></div><div class="artist-chart mt-8 flex h-48 items-end gap-3 px-2" data-artist-chart><i style="--height:38%"></i><i style="--height:55%"></i><i style="--height:46%"></i><i style="--height:72%"></i><i style="--height:64%"></i><i style="--height:90%"></i><i style="--height:78%"></i><i style="--height:100%"></i></div><div class="mt-3 flex justify-between text-xs font-semibold text-slate-400"><span>Ene</span><span>Jun</span><span>Dic</span></div></div></div></section>

      <section class="bg-soft px-5 py-24 sm:px-8 lg:px-10"><div class="mx-auto max-w-3xl"><p class="section-label text-center">Preguntas de artistas</p><h2 class="mt-4 text-center font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Resolvemos tus dudas</h2><div class="mt-10 space-y-3">{artistFaqs.map(([question, answer]) => <details class="rounded-2xl border border-line bg-white p-5"><summary class="cursor-pointer font-extrabold">{question}</summary><p class="mt-3 text-sm leading-7 text-slate-600">{answer}</p></details>)}</div></div></section>
    </main>
    <script>
      const chart = document.querySelector('[data-artist-chart]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (chart && !reduceMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) {
            chart.classList.add('is-visible');
            observer.unobserve(chart);
          }
        }, { threshold: 0.3 });
        observer.observe(chart);
      } else {
        chart?.classList.add('is-visible');
      }
    </script>
  </body>
</html>
