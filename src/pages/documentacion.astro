---
import '../styles/global.css';

const navigation = [
  { group: 'Empezando', items: [{ label: 'Introducción', href: '#introduccion' }, { label: 'Inicio rápido', href: '#inicio-rapido' }, { label: 'Requisitos del sistema', href: '#requisitos-del-sistema' }] },
  { group: 'Funciones', items: [{ label: 'EQ integrada', href: '#eq-integrada' }, { label: 'Calidad WAV/FLAC', href: '#calidad-wavflac' }, { label: 'Segmentación temporal', href: '#segmentacion-temporal' }, { label: 'FlowIA', href: '#flowia' }] },
  { group: 'Referencia', items: [{ label: 'Planes', href: '#planes' }, { label: 'Preguntas frecuentes', href: '#preguntas-frecuentes' }] },
];

const requirements = [
  ['Web', 'Navegador actualizado', 'Chrome, Firefox, Brave, Safari o Edge con Web Audio API habilitada.'],
  ['Android', 'Dispositivo compatible', 'Instala la aplicación Android publicada por MusicFlow.'],
  ['Escritorio', 'Windows, macOS o Linux', 'MusicFlow dispone de instaladores de escritorio para estos sistemas.'],
  ['Conexión', 'Internet estable', 'Necesaria para el catálogo, la cuenta y las solicitudes a FlowIA.'],
];

const faqs = [
  ['¿La EQ afecta la calidad del audio?', 'La ecualización cambia el balance entre graves, medios y agudos. Ajusta primero de forma moderada: subir muchas bandas a la vez puede generar saturación en algunos equipos.'],
  ['¿Mis presets se sincronizan?', 'Los ajustes se guardan en tu cuenta cuando la plataforma compatible está conectada.'],
  ['¿Puedo usar FlowIA sin conexión?', 'No. FlowIA requiere conexión para procesar el prompt y generar la respuesta.'],
  ['¿Hay atajos de teclado?', 'La documentación no define atajos globales como parte de MusicFlow. Usa los controles visibles del reproductor y de cada sección para reproducir, pausar o abrir las herramientas.'],
  ['¿Cómo subo mi música como artista?', 'Ve a la sección Artistas, crea tu perfil y envía la solicitud de revisión antes de publicar.'],
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/assets/music-flow.png" />
    <link rel="apple-touch-icon" href="/assets/music-flow.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Documentación de MusicFlow: ecualización, formatos WAV/FLAC, segmentación temporal y FlowIA." />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" referrerpolicy="no-referrer" />
    <title>Documentación | MusicFlow</title>
  </head>
  <body class="min-h-screen bg-white text-ink">
    <header class="sticky top-0 z-50 border-b border-line/70 bg-white/95 backdrop-blur-xl">
      <nav class="mx-auto flex h-[76px] max-w-7xl items-center justify-between px-5 sm:px-8 lg:px-10" aria-label="Navegación principal">
        <a href="/" class="focusable flex items-center gap-2.5 rounded-full"><img src="/assets/music-flow.png" alt="" width="44" height="44" class="h-10 w-10 rounded-full object-cover" /><span class="font-display text-xl font-extrabold tracking-[-0.04em]">Music<span class="text-pulse">Flow</span></span></a>
        <div class="hidden items-center gap-7 text-[13px] font-semibold text-slate-600 lg:flex"><a href="/#caracteristicas" class="hover:text-pulse">Características</a><a href="/#plataformas" class="hover:text-pulse">Plataformas</a><a href="/#comparativa" class="hover:text-pulse">Comparativa</a><a href="/#comunidad" class="hover:text-pulse">Comunidad</a><a href="/documentacion" class="text-pulse">Documentación</a><a href="/artistas" class="hover:text-pulse">Artistas</a></div>
        <a href="https://musicflowapp.net/" class="focusable rounded-full bg-pulse px-5 py-3 text-sm font-extrabold text-white shadow-glow">Iniciar sesión</a>
      </nav>
    </header>

    <main class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:px-10">
      <div class="text-sm font-semibold text-slate-500"><a href="/" class="hover:text-pulse">Inicio</a><span class="mx-2">/</span><span>Documentación</span></div>
      <div class="mt-8 max-w-3xl"><p class="section-label">Centro de ayuda</p><h1 class="mt-3 font-display text-5xl font-extrabold tracking-[-0.045em]">Documentación</h1><p class="mt-5 text-lg leading-8 text-slate-600">Guía funcional y técnica para entender cómo MusicFlow procesa el sonido, organiza los ajustes y usa FlowIA.</p><p class="mt-4 text-sm font-semibold text-slate-400">v1.0.0 · Última actualización: noviembre de 2026</p></div>

      <div class="mt-14 grid gap-12 lg:grid-cols-[245px_minmax(0,1fr)]">
        <aside class="doc-sidebar h-fit rounded-2xl border border-line bg-soft p-5 lg:sticky lg:top-24">
          <label class="relative block"><span class="sr-only">Buscar en documentación</span><input type="search" placeholder="Buscar" class="w-full rounded-xl border border-line bg-white px-4 py-3 text-sm outline-none transition focus:border-pulse focus:ring-2 focus:ring-pulse/20" /></label>
          {navigation.map((section) => <div class="mt-7"><h2 class="text-[11px] font-extrabold uppercase tracking-[0.13em] text-slate-400">{section.group}</h2><ul class="mt-3 space-y-1">{section.items.map((item) => <li><a href={item.href} class="block rounded-lg px-3 py-2 text-sm font-semibold text-slate-600 transition hover:bg-white hover:text-pulse">{item.label}</a></li>)}</ul></div>)}
        </aside>

        <article class="doc-content min-w-0">
          <section id="introduccion"><h2>Introducción</h2><p>MusicFlow es una plataforma musical centrada en el control del sonido. Su reproductor aplica ecualización mientras escuchas, admite los formatos de audio compatibles y permite guardar ajustes para volver a usarlos. Las funciones Premium añaden ecualización por segmentos y FlowIA.</p><div class="doc-chip-row"><span>EQ integrada</span><span>WAV / FLAC</span><span>Segmentación temporal</span><span>FlowIA</span></div></section>
          <section id="inicio-rapido"><h2>Inicio rápido</h2><ol class="doc-steps"><li><strong>Crea tu cuenta</strong><span>Regístrate gratis con tu correo o proveedor de acceso compatible.</span></li><li><strong>Elige tu plataforma</strong><span>Usa la web o instala MusicFlow en tu dispositivo.</span></li><li><strong>Activa la EQ</strong><span>Ve a Ajustes → Audio → Ecualizador y elige un preset o crea el tuyo.</span></li><li><strong>Prueba FlowIA</strong><span>Describe la playlist o el sonido que quieres mediante un prompt.</span></li></ol></section>
          <section id="requisitos-del-sistema"><h2>Requisitos del sistema</h2><p>MusicFlow no necesita una configuración de audio especial para comenzar. La calidad final también depende del archivo original, tu navegador o aplicación, y tus audífonos o parlantes.</p><div class="doc-table"><table><thead><tr><th>Plataforma</th><th>Requisito</th><th>Notas</th></tr></thead><tbody>{requirements.map((row) => <tr>{row.map((cell, index) => <td>{row[0] === 'Web' && index === 2 ? <><span class="inline-flex items-center gap-1.5"><i class="fa-brands fa-chrome" style="color: rgb(66, 133, 244);" aria-hidden="true"></i>Chrome</span>, <span class="inline-flex items-center gap-1.5"><i class="fa-brands fa-firefox-browser" style="color: rgb(255, 113, 57);" aria-hidden="true"></i>Firefox</span>, <span class="inline-flex items-center gap-1.5"><i class="fa-brands fa-brave" style="color: rgb(255, 99, 0);" aria-hidden="true"></i>Brave</span>, <span class="inline-flex items-center gap-1.5"><i class="fa-brands fa-safari" style="color: rgb(48, 160, 248);" aria-hidden="true"></i>Safari</span> o <span class="inline-flex items-center gap-1.5"><i class="fa-brands fa-edge" style="color: rgb(18, 116, 232);" aria-hidden="true"></i>Edge</span> con Web Audio API habilitada.</> : cell}</td>)}</tr>)}</tbody></table></div></section>
          <section id="eq-integrada"><h2>EQ integrada</h2><p>Ecualizar significa subir o bajar zonas concretas de frecuencia para cambiar cómo percibes una canción: los graves dan peso, los medios definen voces e instrumentos y los agudos aportan detalle. Está integrada porque el ajuste se aplica directamente dentro del reproductor, sin abrir otra aplicación ni alterar el archivo original.</p><p>La EQ de MusicFlow trabaja en tiempo real y puede partir de un preset o de una configuración creada por ti. El sistema resuelve el ajuste correspondiente a tu escucha y, cuando usas segmentos Premium, puede cambiarlo durante una misma canción.</p><div class="doc-table"><table><thead><tr><th>Parámetro</th><th>Valor</th><th>Uso</th></tr></thead><tbody><tr><td>Bandas</td><td>10</td><td>32, 64, 125, 250, 500, 1k, 2k, 4k, 8k y 16k Hz.</td></tr><tr><td>Ganancia</td><td>−15 dB a +15 dB</td><td>Sube o atenúa cada banda.</td></tr><tr><td>Presets</td><td>8 incluidos</td><td>Flat, Bass Boost, Treble Boost, Vocal, Rock, Electronic, Acoustic y Classical.</td></tr></tbody></table></div><aside class="doc-note"><strong>Consejo:</strong> empieza con cambios pequeños. Si el sonido se vuelve áspero o distorsionado, reduce las bandas que aumentaste.</aside></section>
          <section id="calidad-wavflac"><h2>Calidad WAV/FLAC</h2><p>WAV y FLAC son formatos sin pérdida: conservan la información del audio original. WAV no comprime el archivo; FLAC lo comprime sin descartar datos. Esto no “mejora” una fuente comprimida, pero evita añadir otra pérdida cuando el archivo de origen ya es WAV o FLAC.</p><p><strong>Para artistas, MusicFlow solo admite cargas en WAV o FLAC.</strong> No se pueden subir MP3, M4A, OGG, AAC ni otros formatos. Para las cargas de audio, el tamaño máximo admitido es de 50 MB.</p><div class="doc-table"><table><thead><tr><th>Formato admitido</th><th>Tipo</th><th>Cuándo usarlo</th></tr></thead><tbody><tr><td>WAV</td><td>Sin pérdida, sin compresión</td><td>Máster o archivo fuente de alta fidelidad.</td></tr><tr><td>FLAC</td><td>Sin pérdida, comprimido</td><td>Conservar calidad ocupando menos espacio que WAV.</td></tr></tbody></table></div></section>
          <section id="segmentacion-temporal"><h2>Segmentación temporal</h2><p>La segmentación temporal divide la línea de tiempo de una canción en tramos para aplicar a cada uno un ajuste de EQ distinto. Es útil cuando una mezcla necesita más presencia en la voz durante un verso, graves más contenidos en una intro o una respuesta diferente en un coro.</p><p>Esta función es parte de Premium. El cambio ocurre según los tiempos que definas en el editor; no modifica el audio original, solo la manera en que MusicFlow lo procesa al reproducirlo.</p><ol class="doc-steps"><li><strong>Abre la canción</strong><span>Entra a sus controles de ecualización y elige el editor de segmentos.</span></li><li><strong>Define el tramo</strong><span>Marca el tiempo de inicio y fin que quieres tratar de forma distinta.</span></li><li><strong>Asigna la EQ</strong><span>Usa un preset o ajusta las diez bandas para ese tramo.</span></li><li><strong>Escucha y corrige</strong><span>Reproduce la transición y ajusta los tiempos o el preset si lo necesitas.</span></li></ol></section>
          <section id="flowia"><h2>FlowIA</h2><p>FlowIA es la ayuda por lenguaje natural de MusicFlow. En vez de construir una playlist o buscar un ajuste desde cero, describes lo que quieres con tus palabras y la herramienta propone un resultado. Está incluida en Premium y dispone de hasta 200 solicitudes al mes.</p><blockquote>“Una playlist para estudiar, con graves suaves y voces claras”</blockquote><div class="doc-table"><table><thead><tr><th>Solicitud</th><th>Qué puede proponer FlowIA</th></tr></thead><tbody><tr><td>Playlist</td><td>Una selección de música basada en el ambiente, actividad o género que describes.</td></tr><tr><td>Ecualización</td><td>Una sugerencia de EQ a partir del tipo de sonido que buscas.</td></tr></tbody></table></div><aside class="doc-note"><strong>Importante:</strong> revisa la sugerencia y ajusta las bandas a tu gusto; el resultado depende de cómo describas la intención y de la música disponible.</aside></section>
          <section id="planes"><h2>Planes</h2><div class="grid gap-5 sm:grid-cols-2"><div class="plan-card rounded-2xl border border-line p-6"><p class="plan-name text-2xl font-extrabold">Free</p><p class="mt-2 text-3xl font-extrabold">S/ 0</p><ul class="mt-5 space-y-2 text-sm text-slate-600"><li>✓ Reproducción y biblioteca musical</li><li>✓ EQ de 10 bandas</li><li>✓ Hasta 5 presets personalizados</li><li>✓ Anuncios entre canciones</li><li>— Sin FlowIA ni EQ por segmentos</li></ul></div><div class="plan-card plan-card-premium rounded-2xl border-2 border-pulse bg-blue-50/60 p-6"><div class="flex items-center justify-between gap-3"><p class="plan-name text-2xl font-extrabold text-pulse">Premium</p><i class="fa-solid fa-crown fa-rotate-by text-2xl" style="color: rgb(244, 255, 0); --fa-rotate-angle: 45deg;" aria-label="Beneficios Premium"></i></div><p class="mt-2 text-3xl font-extrabold">S/ 13<span class="text-base font-medium">/mes</span></p><ul class="mt-5 space-y-2 text-sm text-slate-600"><li>✓ Sin anuncios</li><li>✓ Descargas para escuchar sin conexión</li><li>✓ FlowIA: hasta 200 solicitudes al mes</li><li>✓ Ecualización por segmentos</li></ul></div></div></section>
          <section id="preguntas-frecuentes"><h2>Preguntas frecuentes</h2><div class="space-y-3">{faqs.map(([question, answer]) => <details class="rounded-xl border border-line bg-white p-5"><summary class="cursor-pointer font-extrabold">{question}</summary><p class="mt-3 text-sm leading-7 text-slate-600">{answer}</p></details>)}</div><a href="/artistas" class="mt-8 inline-flex items-center gap-2 rounded-full bg-pulse px-6 py-3 text-sm font-extrabold text-white shadow-glow">Ir a Artistas <span aria-hidden="true">→</span></a></section>
        </article>
      </div>
    </main>
    <script>
      document.querySelector('#planes > h2')?.classList.add('landing-title');
    </script>
  </body>
</html>
