---
import '../styles/global.css';
import spotifyLogo from '../../assets/Spotify.png';
import ytMusicLogo from '../../assets/YTMusic.png';

const eqBands = [
  { hz: '32', level: 52 },
  { hz: '64', level: 64 },
  { hz: '125', level: 47 },
  { hz: '250', level: 36 },
  { hz: '500', level: 27 },
  { hz: '1k', level: 30 },
  { hz: '2k', level: 43 },
  { hz: '4k', level: 55 },
  { hz: '8k', level: 62 },
  { hz: '16k', level: 50 },
];

const features = [
  {
    eyebrow: '10 bandas',
    title: 'EQ integrada',
    body: 'Ecualiza tus canciones cuando quieras, desde 31 Hz hasta 16 kHz y con perfiles guardados por canción.',
    icon: 'sliders',
  },
  {
    eyebrow: 'Hasta 24-bit/192 kHz',
    title: 'Calidad de sonido WAV/FLAC',
    body: 'Escucha tus canciones favoritas en alta fidelidad, sin perder el detalle de la grabación original.',
    icon: 'wave',
  },
  {
    eyebrow: 'Por segmentos',
    title: 'Segmentación temporal',
    body: 'Aplica una ecualización distinta en la intro, estrofa, coro o cualquier fragmento de la canción.',
    icon: 'timeline',
  },
  {
    eyebrow: 'Con prompts',
    title: 'FlowIA',
    body: 'Genera playlists y ecualiza mediante lenguaje natural con la experiencia Premium de MusicFlow.',
    quote: '“Playlist lo-fi para estudiar, con graves suaves”',
    icon: 'spark',
  },
];

const platforms = [
  {
    type: 'web',
    title: 'Web',
    body: 'Escucha al instante desde cualquier navegador. Sin instalaciones.',
    action: 'Abrir en el navegador',
  },
  {
    type: 'mobile',
    title: 'Móviles',
    body: 'Disponible para iOS y Android, con biblioteca y experiencia sincronizada.',
    action: 'Descargar la app',
  },
  {
    type: 'desktop',
    title: 'Escritorio',
    body: 'Windows, macOS y Linux con una experiencia de audio dedicada.',
    action: 'Descargar para PC',
  },
];

const comparison = [
  { feature: 'Ecualizador integrado avanzado (10 bandas)', note: 'Spotify ofrece un EQ más limitado', musicflow: 'yes', spotify: 'partial', youtube: 'no' },
  { feature: 'Audio sin pérdida WAV / FLAC', note: 'La disponibilidad depende del plan y la región', musicflow: 'yes', spotify: 'partial', youtube: 'no' },
  { feature: 'Ecualización por segmentos de la canción', musicflow: 'yes', spotify: 'no', youtube: 'no' },
  { feature: 'Ecualización mediante prompts (IA)', musicflow: 'yes', spotify: 'no', youtube: 'no' },
  { feature: 'Playlists generadas por IA con prompts', note: 'Disponible según región', musicflow: 'yes', spotify: 'partial', youtube: 'partial' },
  { feature: 'Web, móviles y escritorio', note: 'YT Music no tiene aplicación oficial de escritorio', musicflow: 'yes', spotify: 'yes', youtube: 'partial' },
  { feature: 'Portal y solicitud para artistas', note: 'Sujeto a revisión administrativa', musicflow: 'yes', spotify: 'partial', youtube: 'partial' },
  { feature: 'Plan gratuito', musicflow: 'yes', spotify: 'yes', youtube: 'yes' },
];

const statusClass = {
  yes: 'bg-blue-50 text-pulse',
  partial: 'bg-amber-50 text-amber-700',
  no: 'bg-slate-100 text-slate-400',
};

const mobileNav = [
  { label: 'Características', href: '#caracteristicas' },
  { label: 'Plataformas', href: '#plataformas' },
  { label: 'Comparativa', href: '#comparativa' },
  { label: 'Comunidad', href: '#comunidad' },
];

const downloadOptions = {
  mobile: [
    { label: 'Android', detail: 'MusicFlow V1 · APK', icon: 'fa-android', color: '#17d44f', href: 'https://pub-6f2b26bf8b324bb89b330c8446a750c0.r2.dev/Mobile/Android/MusicFlowV1-Mobile.apk', download: true },
  ],
  desktop: [
    { label: 'Windows', detail: 'Instalador · tutorial próximamente', icon: 'fa-windows', color: '#17a5d4', href: null },
    { label: 'Linux', detail: 'Instalador · tutorial próximamente', icon: 'fa-linux', color: '#000000', href: null },
  ],
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/assets/music-flow.png" />
    <link rel="apple-touch-icon" href="/assets/music-flow.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="MusicFlow combina audio WAV/FLAC, ecualización avanzada, segmentación temporal y FlowIA en web, móvil y escritorio."
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" referrerpolicy="no-referrer" />
    <title>MusicFlow — Deja que la música fluya</title>
  </head>

  <body class="min-h-screen overflow-x-hidden bg-white text-ink">
    <header class="sticky top-0 z-50 border-b border-line/70 bg-white/95 backdrop-blur-xl">
      <nav class="mx-auto flex h-[76px] max-w-7xl items-center justify-between px-5 sm:px-8 lg:px-10" aria-label="Navegación principal">
        <a href="#inicio" class="focusable flex shrink-0 items-center gap-2.5 rounded-full" aria-label="MusicFlow, volver al inicio">
          <img
            src="/assets/music-flow.png"
            alt=""
            width="44"
            height="44"
            class="h-10 w-10 rounded-full object-cover shadow-sm"
          />
          <span class="font-display text-xl font-extrabold tracking-[-0.04em]">Music<span class="text-pulse">Flow</span></span>
        </a>

        <div class="hidden items-center gap-7 text-[13px] font-semibold text-slate-600 lg:flex">
          <a href="#caracteristicas" class="transition hover:text-pulse">Características</a>
          <a href="#plataformas" class="transition hover:text-pulse">Plataformas</a>
          <a href="#comparativa" class="transition hover:text-pulse">Comparativa</a>
          <a href="#comunidad" class="transition hover:text-pulse">Comunidad</a>
          <span class="h-5 w-px bg-line" aria-hidden="true"></span>
          <a href="/documentacion" class="inline-flex items-center gap-2 transition hover:text-pulse">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4.5h11a3 3 0 0 1 3 3v12H8a3 3 0 0 1-3-3v-12Z" stroke="currentColor" stroke-width="1.8" /><path d="M8 4.5v15" stroke="currentColor" stroke-width="1.8" /></svg>
            Documentación
          </a>
          <a href="/artistas" class="inline-flex items-center gap-2 transition hover:text-pulse">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18V6l9-2v12M9 18a3 3 0 1 1-3-3h3m9 1a3 3 0 1 1-3-3h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Artistas
          </a>
        </div>

        <div class="hidden items-center gap-4 sm:flex">
          <a href="https://musicflowapp.net/" class="focusable inline-flex min-h-11 items-center rounded-full bg-pulse px-6 text-sm font-extrabold text-white shadow-glow transition hover:-translate-y-0.5 hover:bg-blue-700">Iniciar sesión</a>
        </div>

        <details class="relative sm:hidden">
          <summary class="focusable grid h-11 w-11 cursor-pointer list-none place-items-center rounded-full border border-line bg-white" aria-label="Abrir menú">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </summary>
          <div class="absolute right-0 top-14 w-64 rounded-2xl border border-line bg-white p-3 shadow-card">
            {mobileNav.map((item) => (
              <a href={item.href} class="block rounded-xl px-4 py-3 text-sm font-bold hover:bg-soft">{item.label}</a>
            ))}
            <a href="https://musicflowapp.net/" class="mt-2 block rounded-xl bg-pulse px-4 py-3 text-center text-sm font-extrabold text-white">Iniciar sesión</a>
          </div>
        </details>
      </nav>
    </header>

    <main>
      <section id="inicio" class="hero-reference relative overflow-hidden px-5 pb-20 pt-14 sm:px-8 lg:px-10 lg:pb-24 lg:pt-20">
        <div class="mx-auto grid max-w-7xl items-center gap-16 lg:grid-cols-[0.96fr_1.04fr]">
          <div class="max-w-2xl">
            <p class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-4 py-2 text-xs font-extrabold text-pulse">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 1.4 4.1L17.5 9l-4.1 1.5L12 15l-1.5-4.5L6.5 9l4-1.9L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
              Nuevo: FlowIA ya disponible
            </p>
            <h1 class="mt-8 font-display text-5xl font-extrabold leading-[1.04] tracking-[-0.055em] sm:text-6xl xl:text-[4.8rem]">
              Tu música,<br /><span class="text-pulse">ecualizada a tu<br class="hidden sm:block" /> manera</span>
            </h1>
            <p class="mt-7 max-w-xl text-base leading-8 text-slate-600 sm:text-lg">
              EQ integrada, audio WAV/FLAC sin pérdida, ecualización por segmentos y una IA que crea tus playlists con solo pedírselo. Esto es <strong class="text-ink">MusicFlow</strong>.
            </p>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a href="https://musicflowapp.net/" class="focusable inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-pulse px-7 text-sm font-extrabold text-white shadow-glow transition hover:-translate-y-0.5 hover:bg-blue-700">
                Escuchar ahora
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
              <a href="/documentacion" class="focusable inline-flex min-h-14 items-center justify-center rounded-full border border-line bg-white px-7 text-sm font-extrabold transition hover:border-pulse hover:text-pulse">Ver documentación</a>
            </div>
            <dl class="mt-11 grid max-w-lg grid-cols-3 gap-5">
              <div><dd class="text-2xl font-extrabold sm:text-3xl">10</dd><dt class="mt-1 text-xs text-slate-500 sm:text-sm">Bandas EQ</dt></div>
              <div><dd class="text-2xl font-extrabold sm:text-3xl">24-bit</dd><dt class="mt-1 text-xs text-slate-500 sm:text-sm">Audio Hi-Res</dt></div>
              <div><dd class="text-2xl font-extrabold sm:text-3xl">3</dd><dt class="mt-1 text-xs text-slate-500 sm:text-sm">Plataformas</dt></div>
            </dl>
          </div>

          <div class="relative mx-auto min-h-[570px] w-full max-w-2xl lg:min-h-[600px]">
            <div class="absolute left-1/2 top-0 h-72 w-72 -translate-x-1/2 rounded-full bg-pulse/15 blur-3xl sm:h-80 sm:w-80"></div>
            <img
              src="/assets/music-flow.png"
              alt="Logo de MusicFlow"
              width="1000"
              height="1000"
              class="logo-float relative mx-auto h-72 w-72 rounded-full object-cover drop-shadow-[0_24px_48px_rgba(23,107,238,0.18)] sm:h-80 sm:w-80"
            />
            <div class="absolute inset-x-0 bottom-0 rounded-[1.8rem] border border-line bg-white p-5 shadow-device sm:inset-x-8 sm:p-7">
              <div class="flex items-center justify-between gap-4">
                <div class="flex min-w-0 items-center gap-3">
                  <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-pulse text-white">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18V6l9-2v12M9 18a3 3 0 1 1-3-3h3m9 1a3 3 0 1 1-3-3h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                  <div class="min-w-0"><p class="text-[11px] font-extrabold text-pulse">REPRODUCIENDO · FLAC 24-BIT</p><p class="truncate font-extrabold">Midnight Waves</p><p class="text-xs text-slate-500">Blue Horizon</p></div>
                </div>
                <span class="eq-on inline-flex items-center gap-1.5 rounded-full px-3 py-2 text-[10px] font-extrabold">ON<i class="eq-active-light" aria-hidden="true"></i></span>
              </div>
              <div class="mt-6 flex h-36 items-end justify-between gap-1.5" aria-label="Ecualizador de 10 bandas">
                {eqBands.map((bar, index) => (
                  <div class="flex h-full min-w-0 flex-1 flex-col items-center justify-end gap-2">
                    <span class={`equalizer-line equalizer-line-${index} relative h-28 w-1 rounded-full`} style={`--level:${bar.level}%`}></span>
                    <span class="text-[9px] font-bold text-slate-400 sm:text-[10px]">{bar.hz}</span>
                  </div>
                ))}
              </div>
              <div class="mt-5 flex gap-2"><span class="rounded-full bg-soft px-3 py-2 text-[11px] font-bold text-slate-600">Bass Boost</span><span class="rounded-full bg-soft px-3 py-2 text-[11px] font-bold text-slate-600">Vocal</span><span class="rounded-full bg-soft px-3 py-2 text-[11px] font-bold text-slate-600">Plano</span></div>
            </div>
          </div>
        </div>
      </section>

      <section id="caracteristicas" class="px-5 py-24 sm:px-8 lg:px-10 lg:py-28">
        <div class="mx-auto max-w-7xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="section-label">Características</p>
            <h2 class="mt-4 font-display text-4xl font-extrabold tracking-[-0.035em] sm:text-5xl">Hecha para quienes sienten la música</h2>
            <p class="mt-5 text-lg text-slate-600">Herramientas profesionales de audio, fáciles para cualquiera.</p>
          </div>
          <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
            {features.map((feature) => (
              <article class="feature-card rounded-3xl border border-line bg-white p-7 shadow-card">
                <span class="grid h-12 w-12 place-items-center rounded-2xl bg-blue-50 text-pulse" aria-hidden="true">
                  {feature.icon === 'sliders' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="M5 4v16M12 4v16M19 4v16M3 9h4M10 15h4M17 7h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>}
                  {feature.icon === 'wave' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="M3 12h3l2-6 4 12 3-9 2 3h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>}
                  {feature.icon === 'timeline' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16M8 5v4m7 1v4m3 1v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>}
                  {feature.icon === 'spark' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none"><path d="m12 3 1.4 4.2L18 9l-4.6 1.8L12 15l-1.4-4.2L6 9l4.6-1.8L12 3Zm6 11 .8 2.2L21 17l-2.2.8L18 20l-.8-2.2L15 17l2.2-.8L18 14Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>}
                </span>
                <p class="mt-7 text-[11px] font-extrabold uppercase tracking-[0.12em] text-pulse">{feature.eyebrow}</p>
                <h3 class="mt-2 text-xl font-extrabold tracking-tight">{feature.title}</h3>
                <p class="mt-3 text-sm leading-7 text-slate-600">{feature.body}</p>
                {feature.quote && <p class="mt-4 border-l-2 border-pulse pl-3 text-xs italic leading-5 text-slate-500">{feature.quote}</p>}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="plataformas" class="bg-soft px-5 py-24 sm:px-8 lg:px-10 lg:py-28">
        <div class="mx-auto max-w-7xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="section-label">Plataformas</p>
            <h2 class="mt-4 font-display text-4xl font-extrabold tracking-[-0.035em] sm:text-5xl">Disponible en <span class="text-pulse">Web, Móviles y Escritorio</span></h2>
            <p class="mt-5 text-lg text-slate-600">Un solo flow en todos tus dispositivos. Tus ecualizaciones siempre sincronizadas.</p>
          </div>
          <div class="mt-14 grid gap-6 lg:grid-cols-3">
            {platforms.map((platform) => (
              <article class="overflow-hidden rounded-3xl border border-line bg-white shadow-card">
                <div class="platform-stage grid h-64 place-items-center bg-gradient-to-br from-white to-blue-50 p-8" aria-hidden="true">
                  {platform.type === 'web' && <div class="browser-mock"><video class="h-full w-full object-cover" autoplay muted loop playsinline preload="metadata" disablepictureinpicture controlslist="nodownload nofullscreen noremoteplayback" aria-label="Demostración web de MusicFlow"><source src="https://pub-379cc6f935d24bca91216ed62a5ed5f3.r2.dev/Video-Demo-WebMusicFlow.mp4" type="video/mp4" /></video></div>}
                  {platform.type === 'mobile' && <div class="phone-video-shell"><video class="pointer-events-none h-full w-full object-cover" autoplay muted loop playsinline preload="metadata" disablepictureinpicture controlslist="nodownload nofullscreen noremoteplayback" aria-label="Demostración móvil de MusicFlow"><source src="https://pub-379cc6f935d24bca91216ed62a5ed5f3.r2.dev/MusicFlow_Demo_MObile.mp4" type="video/mp4" /></video></div>}
                  {platform.type === 'desktop' && <div class="desktop-mock"><video class="h-full w-full rounded-t-xl object-cover" autoplay muted loop playsinline preload="metadata" disablepictureinpicture controlslist="nodownload nofullscreen noremoteplayback" aria-label="Demostración de MusicFlow para escritorio"><source src="https://pub-379cc6f935d24bca91216ed62a5ed5f3.r2.dev/Video-DesktopWindows-MusicFlow.mp4" type="video/mp4" /></video><span class="desktop-stand"></span></div>}
                </div>
                <div class="p-7">
                  <h3 class="text-2xl font-extrabold">{platform.title}</h3>
                  <p class="mt-3 min-h-14 text-sm leading-7 text-slate-600">{platform.body}</p>
                  {platform.type === 'web' ? (
                    <a href="https://musicflowapp.net/" class="mt-6 inline-flex items-center gap-2 text-sm font-extrabold text-pulse hover:text-blue-700">Abrir MusicFlow Web<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
                  ) : (
                    <button type="button" class="focusable mt-6 inline-flex items-center gap-2 text-sm font-extrabold text-pulse hover:text-blue-700" data-download-platform={platform.type}>{platform.action}<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="comparativa" class="px-5 py-24 sm:px-8 lg:px-10 lg:py-28">
        <div class="mx-auto max-w-7xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="section-label">Comparativa</p>
            <h2 class="mt-4 font-display text-4xl font-extrabold tracking-[-0.035em] sm:text-5xl">¿Por qué MusicFlow?</h2>
            <p class="mt-5 text-lg text-slate-600">Compara lo que ofrecemos frente a Spotify y YouTube Music.</p>
          </div>
          <div class="mt-14 overflow-x-auto rounded-3xl border border-line bg-white shadow-card">
            <table class="w-full min-w-[760px] border-collapse text-left">
              <thead>
                <tr class="bg-soft">
                  <th class="px-6 py-5 text-sm font-extrabold">Funcionalidad</th>
                  <th class="px-6 py-5 text-center text-sm font-extrabold text-pulse"><span class="inline-flex items-center gap-2"><img src="/assets/music-flow.png" alt="" class="h-7 w-7 rounded-full object-cover" />MusicFlow</span></th>
                  <th class="px-6 py-5 text-center text-sm font-extrabold"><span class="inline-flex items-center gap-2"><img src={spotifyLogo.src} alt="" class="h-7 w-7 rounded-full object-cover" />Spotify</span></th>
                  <th class="px-6 py-5 text-center text-sm font-extrabold"><span class="inline-flex items-center gap-2"><img src={ytMusicLogo.src} alt="" class="h-7 w-7 rounded-full object-cover" />YT Music</span></th>
                </tr>
              </thead>
              <tbody>
                {comparison.map((row) => (
                  <tr class="border-t border-line">
                    <th scope="row" class="px-6 py-4 text-sm font-bold"><span class="block">{row.feature}</span>{row.note && <span class="mt-1 block text-xs font-normal text-slate-400">{row.note}</span>}</th>
                    {[row.musicflow, row.spotify, row.youtube].map((status) => (
                      <td class="px-6 py-4 text-center"><span class={`mx-auto grid h-7 w-7 place-items-center rounded-full text-sm font-extrabold ${statusClass[status]}`} aria-label={status === 'yes' ? 'Incluido' : status === 'partial' ? 'Parcial o limitado' : 'No disponible'}>{status === 'yes' ? '✓' : status === 'partial' ? '–' : '×'}</span></td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="mt-5 flex flex-wrap justify-center gap-5 text-xs font-semibold text-slate-500">
            <span class="inline-flex items-center gap-2"><i class="grid h-5 w-5 place-items-center rounded-full bg-blue-50 not-italic text-pulse">✓</i>Incluido</span>
            <span class="inline-flex items-center gap-2"><i class="grid h-5 w-5 place-items-center rounded-full bg-amber-50 not-italic text-amber-700">–</i>Parcial / limitado</span>
            <span class="inline-flex items-center gap-2"><i class="grid h-5 w-5 place-items-center rounded-full bg-slate-100 not-italic text-slate-400">×</i>No disponible</span>
          </div>
          <p class="mt-4 text-center text-xs text-slate-400">Comparativa basada en información pública. Las funciones pueden variar según región y plan.</p>
        </div>
      </section>

      <section id="comunidad" class="bg-soft px-5 py-24 sm:px-8 lg:px-10 lg:py-28">
        <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[0.78fr_1.22fr]">
          <div>
            <p class="section-label">Comunidad</p>
            <h2 class="mt-4 font-display text-4xl font-extrabold tracking-[-0.035em] sm:text-5xl">Únete a la comunidad MusicFlow</h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Entérate de lanzamientos, comparte presets de EQ y conversa con personas que disfrutan la música tanto como tú.</p>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <a href="https://www.instagram.com/musicflow_oficial/" target="_blank" rel="noreferrer" class="community-card rounded-3xl border border-line bg-white p-7 shadow-card">
              <div class="flex items-start justify-between"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-fuchsia-500 to-orange-400 text-white"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg></span><svg class="h-5 w-5 text-slate-400" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
              <p class="mt-7 text-xs font-extrabold uppercase tracking-wider text-slate-400">Instagram</p><h3 class="mt-2 text-xl font-extrabold">@musicflow</h3><p class="mt-3 text-sm text-slate-600">Novedades, lanzamientos y contenido de la comunidad.</p>
            </a>
            <a href="https://discord.gg/M5gZ5Dbfp" target="_blank" rel="noreferrer" class="community-card rounded-3xl border border-line bg-white p-7 shadow-card">
              <div class="flex items-start justify-between"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-indigo-50"><i class="fa-brands fa-discord text-2xl" style="color: rgb(71, 64, 196);" aria-hidden="true"></i></span><svg class="h-5 w-5 text-slate-400" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
              <p class="mt-7 text-xs font-extrabold uppercase tracking-wider text-slate-400">Discord</p><h3 class="mt-2 text-xl font-extrabold">Comunidad MusicFlow</h3><p class="mt-3 text-sm text-slate-600">Comparte presets y conversa con otros amantes del audio.</p>
            </a>
          </div>
        </div>
      </section>
    </main>

    <dialog id="download-dialog" class="w-[min(92vw,31rem)] rounded-3xl border border-line bg-white p-0 text-ink shadow-device backdrop:bg-slate-950/45" aria-labelledby="download-dialog-title">
      <div class="p-6 sm:p-8">
        <div class="flex items-start justify-between gap-5"><div><p class="section-label" id="download-dialog-label">Descargas</p><h2 id="download-dialog-title" class="mt-2 font-display text-3xl font-extrabold">Elige tu versión</h2><p class="mt-3 text-sm leading-6 text-slate-600">Selecciona el sistema operativo y el formato de instalación.</p></div><button type="button" class="focusable grid h-10 w-10 place-items-center rounded-full border border-line text-xl text-slate-500 hover:bg-soft" data-download-close aria-label="Cerrar menú de descargas">×</button></div>
        {Object.entries(downloadOptions).map(([platform, options]) => <div class="mt-7 space-y-3" data-download-options={platform} hidden>{options.map((option) => <div class="flex items-center gap-3 rounded-2xl border border-line bg-soft p-4"><i class={`fa-brands ${option.icon} w-7 text-center text-2xl`} style={`color: ${option.color};`} aria-hidden="true"></i><div class="min-w-0 flex-1"><strong class="block text-sm font-extrabold">{option.label}</strong><span class="mt-1 block text-xs text-slate-500">{option.detail}</span></div>{option.href ? <a href={option.href} class="focusable rounded-full bg-pulse px-4 py-2 text-xs font-extrabold text-white" data-download-link={platform} download={option.download ? true : undefined}>Descargar</a> : <button type="button" class="focusable rounded-full bg-pulse px-4 py-2 text-xs font-extrabold text-white" data-download-pending={platform}>Descargar</button>}</div>)}</div>)}
        <p class="mt-6 text-xs leading-5 text-slate-500">Consulta los requisitos de instalación antes de descargar. La guía de instalación en video estará disponible próximamente.</p>
        <div class="mt-4 flex flex-wrap gap-3"><a href="/requisitos?plataforma=mobile" data-requirements-link class="focusable inline-flex min-h-10 items-center rounded-full border border-line bg-white px-4 text-xs font-extrabold text-pulse">Requisitos para Android</a></div>
      </div>
    </dialog>

    <dialog id="tutorial-dialog" class="w-[min(92vw,42rem)] rounded-3xl border border-line bg-white p-0 text-ink shadow-device backdrop:bg-slate-950/45" aria-labelledby="tutorial-title">
      <div class="p-6 sm:p-8"><div class="flex items-start justify-between gap-5"><div><p class="section-label">Instalación</p><h2 id="tutorial-title" class="mt-2 font-display text-2xl font-extrabold">¿Te gustaría ver el tutorial?</h2><p class="mt-2 text-sm text-slate-600">El video de instalación estará disponible próximamente.</p></div><button type="button" class="focusable grid h-10 w-10 place-items-center rounded-full border border-line text-xl text-slate-500 hover:bg-soft" data-tutorial-close aria-label="Cerrar">×</button></div><div class="mt-6 flex gap-3" data-tutorial-choices><button type="button" class="focusable rounded-full bg-pulse px-5 py-3 text-sm font-extrabold text-white" data-tutorial-answer="yes">Sí, ver tutorial</button><button type="button" class="focusable rounded-full border border-line px-5 py-3 text-sm font-extrabold" data-tutorial-answer="no">No, continuar</button></div><div class="mt-6" data-tutorial-video hidden><div class="grid aspect-video place-items-center rounded-2xl bg-soft p-6 text-center"><div><span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-blue-100 text-pulse"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 8v4l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></span><p class="mt-4 font-extrabold">Tutorial próximamente</p><p class="mt-1 text-sm text-slate-500">Publicaremos aquí el video de instalación.</p></div></div></div></div>
    </dialog>

    <footer id="artistas" class="border-t border-line bg-white px-5 pb-8 pt-16 sm:px-8 lg:px-10">
      <div class="mx-auto grid max-w-7xl gap-12 md:grid-cols-[1.5fr_0.7fr_0.7fr_0.7fr]">
        <div class="max-w-sm">
          <a href="#inicio" class="inline-flex items-center gap-3"><img src="/assets/music-flow.png" alt="" class="h-11 w-11 rounded-full object-cover" /><span class="font-display text-xl font-extrabold">Music<span class="text-pulse">Flow</span></span></a>
          <p class="mt-5 text-sm leading-7 text-slate-500">Ecualiza, escucha en alta calidad y deja que FlowIA cree el ambiente perfecto para ti.</p>
        </div>
        <div><h3 class="text-sm font-extrabold">Producto</h3><ul class="mt-5 space-y-3 text-sm text-slate-500"><li><a href="#caracteristicas" class="hover:text-pulse">Características</a></li><li><a href="#plataformas" class="hover:text-pulse">Plataformas</a></li><li><a href="#comparativa" class="hover:text-pulse">Comparativa</a></li></ul></div>
        <div><h3 class="text-sm font-extrabold">Recursos</h3><ul class="mt-5 space-y-3 text-sm text-slate-500"><li><a href="/documentacion" class="hover:text-pulse">Documentación</a></li><li><a href="/artistas" class="hover:text-pulse">Para artistas</a></li><li><a href="#comunidad" class="hover:text-pulse">Comunidad</a></li></ul></div>
        <div><h3 class="text-sm font-extrabold">Legal</h3><ul class="mt-5 space-y-3 text-sm text-slate-500"><li><a href="#" class="hover:text-pulse">Términos</a></li><li><a href="#" class="hover:text-pulse">Privacidad</a></li><li><a href="#" class="hover:text-pulse">Cookies</a></li></ul></div>
      </div>
      <div class="mx-auto mt-14 max-w-7xl border-t border-line pt-6 text-center text-xs text-slate-400">© 2026 MusicFlow. Todos los derechos reservados.</div>
    </footer>
    <script>
      const downloadDialog = document.querySelector('#download-dialog');
      const downloadTitle = document.querySelector('#download-dialog-title');
      const downloadLabel = document.querySelector('#download-dialog-label');
      const optionGroups = document.querySelectorAll('[data-download-options]');

      document.querySelectorAll('[data-download-platform]').forEach((button) => {
        button.addEventListener('click', () => {
          const platform = button.dataset.downloadPlatform;
          optionGroups.forEach((group) => { group.hidden = group.dataset.downloadOptions !== platform; });
          const requirementsLink = document.querySelector('[data-requirements-link]');
          if (requirementsLink) {
            requirementsLink.href = `/requisitos?plataforma=${platform}`;
            requirementsLink.textContent = platform === 'mobile' ? 'Requisitos para Android' : 'Requisitos para escritorio';
          }
          downloadLabel.textContent = platform === 'mobile' ? 'Descargas móviles' : 'Descargas de escritorio';
          downloadTitle.textContent = platform === 'mobile' ? 'Elige tu dispositivo' : 'Elige tu sistema';
          downloadDialog?.showModal();
        });
      });

      document.querySelector('[data-download-close]')?.addEventListener('click', () => downloadDialog?.close());
      downloadDialog?.addEventListener('click', (event) => { if (event.target === downloadDialog) downloadDialog.close(); });

      const tutorialDialog = document.querySelector('#tutorial-dialog');
      document.querySelectorAll('[data-download-link], [data-download-pending]').forEach((control) => {
        control.addEventListener('click', (event) => {
          const platform = control.dataset.downloadLink || control.dataset.downloadPending;
          const downloadHref = control.dataset.downloadLink ? control.href : null;
          if (!downloadHref) event.preventDefault();
          event.preventDefault();
          if (tutorialDialog) {
            tutorialDialog.dataset.downloadHref = downloadHref || '';
            tutorialDialog.dataset.platform = platform;
            tutorialDialog.showModal();
          }
        });
      });

      document.querySelectorAll('[data-tutorial-answer]').forEach((button) => {
        button.addEventListener('click', () => {
          const wantsTutorial = button.dataset.tutorialAnswer === 'yes';
          const tutorialChoices = document.querySelector('[data-tutorial-choices]');
          const tutorialVideo = document.querySelector('[data-tutorial-video]');
          const downloadHref = tutorialDialog?.dataset.downloadHref;
          if (!wantsTutorial && downloadHref) window.location.href = downloadHref;
          if (wantsTutorial) {
            tutorialChoices?.setAttribute('hidden', '');
            tutorialVideo?.removeAttribute('hidden');
          }
          if (!wantsTutorial) tutorialDialog?.close();
        });
      });
      document.querySelector('[data-tutorial-close]')?.addEventListener('click', () => tutorialDialog?.close());

      document.querySelectorAll('#inicio h1, #caracteristicas h2, #plataformas h2, #comparativa h2, #comunidad h2').forEach((title) => {
        title.classList.add('landing-title');
      });
    </script>
  </body>
</html>
