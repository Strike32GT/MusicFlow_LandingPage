---
import '../styles/global.css';

const platform = Astro.url.searchParams.get('plataforma') === 'mobile' ? 'mobile' : 'desktop';
const isMobile = platform === 'mobile';
const title = isMobile ? 'Requisitos para móviles' : 'Requisitos para escritorio';
const requirements = isMobile
  ? [
      ['Mínimos', 'Android compatible con la aplicación MusicFlow.'],
      ['Recomendables', 'Android actualizado, espacio libre suficiente para instalar el APK y conexión a internet para iniciar sesión y usar el catálogo.'],
    ]
  : [
      ['Mínimos', 'Windows compatible con el instalador oficial de MusicFlow.'],
      ['Recomendables', 'Windows actualizado, espacio libre suficiente para instalar la aplicación y conexión a internet para iniciar sesión y usar el catálogo.'],
    ];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/assets/music-flow.png" />
    <link rel="apple-touch-icon" href="/assets/music-flow.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Requisitos mínimos y recomendables para instalar MusicFlow." />
    <title>{title} | MusicFlow</title>
  </head>
  <body class="min-h-screen bg-white text-ink">
    <header class="border-b border-line bg-white"><nav class="mx-auto flex h-[76px] max-w-5xl items-center justify-between px-5 sm:px-8" aria-label="Navegación principal"><a href="/" class="focusable flex items-center gap-2.5 rounded-full"><img src="/assets/music-flow.png" alt="" width="44" height="44" class="h-10 w-10 rounded-full object-cover" /><span class="font-display text-xl font-extrabold">Music<span class="text-pulse">Flow</span></span></a><a href="/" class="text-sm font-bold text-pulse">Volver al inicio</a></nav></header>
    <main class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
      <p class="section-label">{isMobile ? 'Android' : 'Windows'}</p>
      <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Revisa la información antes de instalar. Los requisitos técnicos exactos dependerán de la versión publicada de la aplicación.</p>
      <div class="mt-12 grid gap-5 md:grid-cols-2">{requirements.map(([heading, body]) => <section class="rounded-3xl border border-line bg-soft p-7"><h2 class="text-xl font-extrabold">{heading}</h2><p class="mt-4 leading-7 text-slate-600">{body}</p></section>)}</div>
      <p class="mt-8 text-sm leading-6 text-slate-500">Para evitar incompatibilidades, descarga siempre la versión enlazada desde el sitio oficial de MusicFlow.</p>
    </main>
  </body>
</html>
